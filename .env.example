DATABASE_URL=postgresql+psycopg://fastapi:fastapi@localhost:5432/fastapi_template # pragma: allowlist secret
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
POSTGRES_DB=fastapi_template
POSTGRES_USER=fastapi
POSTGRES_PASSWORD=fastapi

# development-only 예제값입니다. 운영 환경에서는 반드시 별도의 비밀키로 교체하세요.
JWT_SECRET_KEY=development-only-jwt-secret-key-at-least-32-bytes # pragma: allowlist secret
JWT_ISSUER=template-python-fastapi
JWT_AUDIENCE=template-python-fastapi
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=2592000
JWT_LEEWAY_SECONDS=0
REDIS_URL=redis://localhost:6379/0
